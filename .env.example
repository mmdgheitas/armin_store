# Flask Core
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=120
ADMIN_URL_PREFIX=/admin
BASE_URL=http://localhost:5000

# Database & Storage
DATABASE_PATH=instance/armin_store.db
UPLOAD_FOLDER=instance/uploads
BACKUP_FOLDER=instance/backups
LOG_FOLDER=instance/logs
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=40

# Bitpay.ir Payment Gateway
# PAYMENT_MODE: mock | test | production
PAYMENT_MODE=mock
BITPAY_API_KEY=your-bitpay-api-key
BITPAY_TIMEOUT_SECONDS=15
BITPAY_RETRIES=2

# SMS.ir Service
# SMS_MODE: mock | production
SMS_MODE=mock
SMSIR_API_KEY=your-smsir-api-key
SMSIR_LINE_NUMBER=30000000000000
SMSIR_TIMEOUT_SECONDS=10
SMSIR_OTP_TEMPLATE_ID=100000

# OTP & Security
OTP_SECRET=change-this-otp-hmac-secret-in-production
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
RATELIMIT_STORAGE_URI=memory://

# Default Seed Admin (used only by scripts/seed.py)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@arminstore.ir
SEED_ADMIN_MOBILE=09120000000
SEED_ADMIN_PASSWORD=ChangeMe123!@#
