# نمونه تنظیمات محیطی — این فایل را به .env کپی کنید (اختیاری)
# در cPanel می‌توانید متغیرها را در بخش Python App > Environment Variables تنظیم کنید.

# محیط اجرا: production | development
FLASK_ENV=production

# کلید نشست (در صورت خالی بودن، به‌صورت خودکار در instance/secret_key.txt ساخته می‌شود)
SECRET_KEY=

# مسیر دیتابیس (پیش‌فرض: instance/store.db)
# DATABASE_PATH=/home/USER/armin_store/instance/store.db

# مسیر پوشه‌های داده (پیش‌فرض: کنار پروژه)
# INSTANCE_DIR=/home/USER/armin_store/instance
# STORAGE_DIR=/home/USER/armin_store/storage
# BACKUP_DIR=/home/USER/armin_store/backups

# سقف کل حجم درخواست آپلود (مگابایت) — باید با محدودیت هاست هماهنگ باشد
MAX_CONTENT_LENGTH_MB=80

# کوکی امن در HTTPS (روی HTTPS حتماً 1 باشد)
SESSION_COOKIE_SECURE=1

# پروتکل مورد انتظار
PREFERRED_URL_SCHEME=https

# اعتماد به هدرهای پروکسی cPanel
TRUST_PROXY_HEADERS=1

# کلید نصب (اختیاری): اگر تنظیم شود، در Setup Wizard به‌جای فایل instance/install_key.txt استفاده می‌شود
SETUP_KEY=

# سطح لاگ: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
